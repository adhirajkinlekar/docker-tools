# ── GitHub Models (recommended for GitHub PAT) ────────────────
# Create a GitHub PAT at https://github.com/settings/tokens
# No special scope needed — free tier includes model access.
OPENAI_API_KEY=github_pat_...
OPENAI_BASE_URL=https://models.inference.ai.azure.com
AGENT_MODEL=gpt-4o

# ── Azure OpenAI (alternative) ────────────────────────────────
# OPENAI_API_KEY=<Azure key>
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# AGENT_MODEL=gpt-4o

# ── Plain OpenAI (alternative) ────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=        # leave blank
# AGENT_MODEL=gpt-4o

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── SQL Server ────────────────────────────────────────────────
MSSQL_SA_PASSWORD=YourStrong@Passw0rd
