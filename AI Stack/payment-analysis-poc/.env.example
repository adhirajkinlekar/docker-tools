# ── Primary provider ──────────────────────────────────────────
# This is the provider used first (in Auto mode) or exclusively (in External mode).
# When Auto is selected and the primary provider hits a quota/rate limit,
# the agent automatically retries with the Ollama container.

# Option A – Ollama only (default, fully local, no API key):
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://ollama:11434/v1
# AGENT_MODEL=llama3.2

# Option B – Groq (free hosted tier – fast, recommended for best responses):
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AGENT_MODEL=llama-3.3-70b-versatile

# Option C – GitHub Models (GitHub PAT):
# OPENAI_API_KEY=github_pat_...
# OPENAI_BASE_URL=https://models.inference.ai.azure.com
# AGENT_MODEL=gpt-4o

# Option D – Plain OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# AGENT_MODEL=gpt-4o

# ── Ollama fallback ────────────────────────────────────────────
# Model to use when falling back to Ollama (auto-fallback or "Ollama" mode).
# ollama-init will pull this model on first startup (~2–4 GB download).
FALLBACK_MODEL=llama3.2

# ── MinIO ──────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── SQL Server ─────────────────────────────────────────────────
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# ── Cache TTL ──────────────────────────────────────────────────
CACHE_TTL_HOURS=24
